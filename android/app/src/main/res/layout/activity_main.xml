<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/root"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <!-- Permission -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_permission" />

        <TextView
            android:id="@+id/permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/permission_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Timing -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_time" />

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowLabel"
                android:labelFor="@id/interval"
                android:text="@string/click_every" />

            <EditText
                android:id="@+id/interval"
                style="@style/NumberField" />

            <Spinner
                android:id="@+id/unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowLabel"
                android:labelFor="@id/jitter"
                android:text="@string/jitter" />

            <EditText
                android:id="@+id/jitter"
                style="@style/NumberField"
                android:maxLength="4" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowLabel"
                android:labelFor="@id/repeat"
                android:text="@string/repeat" />

            <EditText
                android:id="@+id/repeat"
                style="@style/NumberField" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/click_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/click_now" />

        <!-- Tap -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_click" />

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowLabel"
                android:text="@string/tap_type" />

            <Spinner
                android:id="@+id/tap_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/Row">

            <TextView
                style="@style/RowLabel"
                android:labelFor="@id/pos_jitter"
                android:text="@string/pos_jitter" />

            <EditText
                android:id="@+id/pos_jitter"
                style="@style/NumberField"
                android:maxLength="3" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/keep_screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/keep_screen_on" />

        <!-- Position -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_target" />

        <TextView
            android:id="@+id/target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/how_to" />

        <Button
            android:id="@+id/show_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:text="@string/show_panel" />
    </LinearLayout>
</ScrollView>
